{
  "name": "download-attachment",
  "version": "1.0.0",
  "description": "Lambda esposta ad AppIO per il download degli allegati di un messaggio",
  "main": "index.js",
  "scripts": {
    "test-build": "npm run test && npm run coverage && npm run build",
    "build": "npm prune --production && rm -f ./function.zip && zip -r ./function.zip . -x './src/test/*' -x '*.md' -x '*.env' -x './coverage/*' -x './.nyc_output/*' -x './.scannerwork/*'",
    "test": "nyc --reporter=html --reporter=text mocha './src/test/**/*.test.js' --recursive --timeout=3000 --exit -r dotenv/config",
    "coverage": "nyc report --reporter=lcov",
    "local-dev": "node local-dev.js"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.577.0",
    "@aws-sdk/lib-dynamodb": "^3.577.0",
    "aws-sdk-client-mock": "^4.0.0",
    "http-request-mock": "^1.8.18",
    "chai": "^4.3.6",
    "dotenv": "^16.0.0",
    "lambda-tester": "^4.0.1",
    "mocha": "^9.2.2",
    "nyc": "^15.1.0",
    "proxyquire": "^2.1.3",
    "sonarqube-scanner": "^3.3.0"
  }
}
